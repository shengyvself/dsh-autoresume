{
  "name": "dsh-autoresume",
  "version": "0.0.9",
  "description": "web 重启或网络瞬时故障中断的 dsh 会话自动继续：全域扫描近 24h 会话、按原模型预设恢复、liveWatch 补捞运行期失败、死循环守卫；completed/settled 一律不打扰。",
  "type": "module",
  "main": "./lib/service.js",
  "exports": {
    ".": {
      "import": "./lib/service.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.5"
  },
  "license": "Apache-2.0"
}
